# Copy this file to .env and replace every "change-me" value.
# .env is git-ignored. Never commit real passwords.

# --- MySQL server (Docker) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=bug_bounty_ledger
MYSQL_TEST_DATABASE=bug_bounty_ledger_test
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# --- Least-privilege application accounts (created by npm run db:users) ---
DB_AUTH_USER=app_auth
DB_AUTH_PASSWORD=change-me-auth
DB_ADMIN_USER=app_admin
DB_ADMIN_PASSWORD=change-me-admin
DB_RESEARCHER_USER=app_researcher
DB_RESEARCHER_PASSWORD=change-me-researcher
DB_VECTOR_USER=app_vector
DB_VECTOR_PASSWORD=change-me-vector

# --- Qdrant ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=vulnerability_reports

# --- Embeddings (runs locally, downloaded once from Hugging Face) ---
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Provisional. Replace with the value chosen by `npm run vector:eval`.
SIMILARITY_THRESHOLD=0.70

# --- Sessions ---
SESSION_TTL_HOURS=8
