{
  "name": "automated-bug-bounty-ledger",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:users": "bash scripts/db-users.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "db:test-reset": "bash scripts/db-reset.sh bug_bounty_ledger_test",
    "qdrant:init": "tsx scripts/qdrant-init.ts",
    "vector:backfill": "tsx scripts/vector-backfill.ts",
    "vector:sync": "tsx scripts/vector-sync.ts",
    "vector:reconcile": "tsx scripts/vector-reconcile.ts",
    "vector:eval": "tsx scripts/threshold-eval.ts",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/db tests/integration",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@qdrant/js-client-rest": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "mysql2": "^3.24.6",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
